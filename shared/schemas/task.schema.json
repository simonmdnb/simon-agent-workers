{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "state/tasks.json",
  "description": "Map of ticket id to task record. Owned by the Lead. The jq checks in scripts/validate-state.sh mirror this file; change both together.",
  "type": "object",
  "propertyNames": {
    "pattern": "^[A-Za-z][A-Za-z0-9]*-[0-9]+$"
  },
  "additionalProperties": { "$ref": "#/$defs/task" },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "slack_channel_id",
        "slack_thread_ts",
        "linear_issue",
        "branch",
        "worktree",
        "status",
        "assigned_agent",
        "hop_count",
        "fail_loops",
        "notes_file"
      ],
      "properties": {
        "slack_channel_id": { "type": "string", "minLength": 1 },
        "slack_thread_ts": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "description": "ts of the root TASK message. With the channel id it identifies the ticket thread."
        },
        "slack_thread_url": { "type": "string" },
        "linear_issue": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "worktree": { "type": "string", "minLength": 1 },
        "pr": { "type": ["integer", "null"] },
        "status": {
          "enum": ["queued", "in_progress", "waiting_qa", "waiting_simon", "blocked", "done"]
        },
        "assigned_agent": {
          "enum": ["frontend-dev", "backend-dev", "qa", "product", "designer", "ops-mail", "maintainer"]
        },
        "agent_id": { "type": "string", "description": "Id of the running role agent, empty if none is alive." },
        "hop_count": { "type": "integer", "minimum": 0, "maximum": 6 },
        "fail_loops": { "type": "integer", "minimum": 0, "maximum": 3 },
        "summary": { "type": "string" },
        "notes_file": { "type": "string", "minLength": 1 },
        "linear_notes_doc_id": { "type": "string", "description": "Id of the Linear document that mirrors the notes file. Empty until first saved." },
        "last_activity": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["waiting_qa", "waiting_simon"] },
              "assigned_agent": { "not": { "const": "maintainer" } }
            },
            "required": ["status"]
          },
          "then": { "required": ["pr"], "properties": { "pr": { "type": "integer" } } }
        }
      ]
    }
  }
}
